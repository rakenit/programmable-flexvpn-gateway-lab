### IKEv2 Identity-Specific Configuration ###
#
# Each entry maps an IKEv2 identity and NAS-Identifier to the PSK and dynamic
# tunnel attributes returned to the requesting hub.

crtspk1.lab.example.net   Cleartext-Password := "<REPLACE_WITH_RADIUS_AUTH_PASSWORD>", Nas-Identifier == "hub-01"
                Tunnel-Type = ESP,
                Tunnel-Medium-type = IPv4,
                cisco-avpair = "ipsec:ikev2-password-local=<REPLACE_WITH_LOCAL_IKEV2_PSK>",
                cisco-avpair = "ipsec:ikev2-password-remote=<REPLACE_WITH_REMOTE_IKEV2_PSK>",
                cisco-avpair = "ipsec:route-accept=none",
                cisco-avpair = "ip:interface-config=vrf forwarding CUST-L3VPN",
                cisco-avpair = "ip:interface-config=ip address 169.254.10.29 255.255.255.252",
                cisco-avpair = "ip:interface-config=description Tunnel to Cisco Router crtspk1.lab.example.net",
                cisco-avpair = "ip:interface-config=service-policy input RM-500MB-IN",
                cisco-avpair = "ip:interface-config=service-policy output RM-500MB-OUT"

crtspk1.lab.example.net   Cleartext-Password := "<REPLACE_WITH_RADIUS_AUTH_PASSWORD>", Nas-Identifier == "hub-02"
                Tunnel-Type = ESP,
                Tunnel-Medium-type = IPv4,
                cisco-avpair = "ipsec:ikev2-password-local=<REPLACE_WITH_LOCAL_IKEV2_PSK>",
                cisco-avpair = "ipsec:ikev2-password-remote=<REPLACE_WITH_REMOTE_IKEV2_PSK>",
                cisco-avpair = "ipsec:route-accept=none",
                cisco-avpair = "ip:interface-config=vrf forwarding CUST-L3VPN",
                cisco-avpair = "ip:interface-config=ip address 169.254.11.29 255.255.255.252",
                cisco-avpair = "ip:interface-config=description Tunnel to Cisco Router crtspk1.lab.example.net",
                cisco-avpair = "ip:interface-config=service-policy input RM-500MB-IN",
                cisco-avpair = "ip:interface-config=service-policy output RM-500MB-OUT"

