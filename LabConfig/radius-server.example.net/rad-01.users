### IKEv2 Group-Specific Configuration ###
#
# Group entries provide shared tunnel attributes for all matching spokes.

rm-grp-crtr     Cleartext-Password := "<REPLACE_WITH_RADIUS_AUTH_PASSWORD>"
                cisco-avpair = "ipsec:route-accept=none",
                cisco-avpair = "ipsec:ipsec-flow-limit=1",
                cisco-avpair = "ip:interface-config=description Tunnel to Cisco router spokes",
                cisco-avpair = "ip:interface-config=ip tcp adjust-mss 1360",
                cisco-avpair = "ip:interface-config=ip mtu 1400",
                cisco-avpair = "ip:interface-config=crypto ipsec df-bit clear",
                cisco-avpair = "ip:interface-config=tunnel path-mtu-discovery",
                cisco-avpair = "ip:interface-config=service-policy input RM-500MB-IN",
                cisco-avpair = "ip:interface-config=service-policy output RM-500MB-OUT"

rm-grp-asa      Cleartext-Password := "<REPLACE_WITH_RADIUS_AUTH_PASSWORD>"
                cisco-avpair = "ipsec:route-accept=none",
                cisco-avpair = "ipsec:ipsec-flow-limit=1",
                cisco-avpair = "ip:interface-config=description Tunnel to Cisco ASA spokes",
                cisco-avpair = "ip:interface-config=ip tcp adjust-mss 1360",
                cisco-avpair = "ip:interface-config=ip mtu 1400",
                cisco-avpair = "ip:interface-config=crypto ipsec df-bit clear",
                cisco-avpair = "ip:interface-config=tunnel path-mtu-discovery",
                cisco-avpair = "ip:interface-config=service-policy input RM-500MB-IN",
                cisco-avpair = "ip:interface-config=service-policy output RM-500MB-OUT"

# On no match, FreeRADIUS denies access.
